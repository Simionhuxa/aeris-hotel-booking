{
  "name": "aeris-mountain-retreat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit",
    "build": "npm run typecheck && vite build && tsc -p server/tsconfig.json",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test src/lib/booking.test.ts server/validation.test.ts",
    "dev:api": "tsx watch server/index.ts",
    "dev:demo": "vite --host 127.0.0.1 --mode demo",
    "build:demo": "tsc --noEmit && vite build --mode demo",
    "start:api": "node dist-server/server/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test:integration": "tsx --test server/api.integration.test.ts",
    "test:browser": "playwright test",
    "test:fullstack": "playwright test --config playwright.fullstack.config.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@tailwindcss/vite": "^4.1.17",
    "@vitejs/plugin-react": "^5.1.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "gsap": "^3.13.0",
    "helmet": "^8.3.0",
    "lenis": "^1.3.15",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5",
    "tailwindcss": "^4.1.17",
    "vite": "^7.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/supertest": "^7.2.1",
    "prisma": "^6.19.3",
    "supertest": "^7.3.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
